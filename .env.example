# 腾讯云开发配置模板
# 复制此文件为 .env.local 并填写实际值

# 云开发环境 ID（在 CloudBase 控制台查看）
TENCENT_CLOUD_ENV_ID=your-env-id-here

# 子账号密钥（请勿使用主账号密钥）
TENCENT_CLOUD_SECRET_ID=YOUR_SECRET_ID
TENCENT_CLOUD_SECRET_KEY=YOUR_SECRET_KEY

# 云开发地域（如 ap-shanghai, ap-guangzhou, ap-beijing）
TENCENT_CLOUD_REGION=ap-shanghai

# 百度 AI 配置（T1.2.1 完成后填写）
# BAIDU_AI_APP_ID=
# BAIDU_AI_API_KEY=
# BAIDU_AI_SECRET_KEY=